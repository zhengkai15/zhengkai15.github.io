---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 页面不存在">
  <div class="mx-auto flex max-w-3xl flex-col items-center py-24 text-center">
    <h1 class="text-6xl font-semibold" style="color: var(--accent);">404</h1>
    <p class="mt-4 text-lg" style="color: var(--text-muted);">这个页面不存在或已被移动。</p>
    <a href="/" class="mt-8 rounded-md px-5 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90" style="background: var(--accent);">
      返回首页
    </a>
  </div>
</BaseLayout>
