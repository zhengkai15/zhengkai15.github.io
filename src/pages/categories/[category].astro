---
import { getCollection } from 'astro:content';
import ListLayout from '../../layouts/ListLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('post', ({ data }) => !data.draft);
  const categories = new Set(allPosts.map((p) => p.data.categories));
  return Array.from(categories).map((category) => ({ params: { category } }));
}

const { category } = Astro.props;
const posts = (await getCollection('post', ({ data }) => !data.draft && data.categories === category)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<ListLayout
  title={`分类：${category}`}
  description={`${posts.length} 篇文章`}
  posts={posts}
/>
