---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const allPosts = (await getPublishedPosts()).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const recentPosts = allPosts.slice(0, 5);
---

<BaseLayout>
  <!-- Profile 模式（复刻 PaperMod profileMode） -->
  <section class="mx-auto flex max-w-3xl flex-col items-center py-16 text-center">
    <img
      src="https://avatars.githubusercontent.com/u/59335385?v=4"
      alt="Kai Zheng"
      width="180"
      height="180"
      class="rounded-full border-4 mb-8"
      style="border-color: var(--border);"
    />

    <h1 class="text-3xl font-semibold">Kai Zheng</h1>

    <p class="mt-4 text-base leading-relaxed" style="color: var(--text-muted);">
      Algorithm Engineer · AI for Science<br />
      Weather Forecasting Foundation Models · Diffusion · Multimodal<br />
      LLM Data Engineering · Generative Models · RL Post-training
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/post/" class="rounded-md px-5 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90" style="background: var(--accent);">
        Posts
      </a>
      <a href="/about/" class="rounded-md border px-5 py-2 text-sm font-medium transition-colors" style="border-color: var(--border); color: var(--text);">
        About
      </a>
      <a href="https://github.com/zhengkai15" class="rounded-md border px-5 py-2 text-sm font-medium transition-colors" style="border-color: var(--border); color: var(--text);">
        GitHub
      </a>
    </div>

    <!-- 社交图标 -->
    <div class="mt-8 flex items-center gap-4" style="color: var(--text-muted);">
      <a href="https://github.com/zhengkai15" aria-label="GitHub" class="transition-colors hover:text-[var(--accent-strong)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.49 5.92.43.38.82 1.11.82 2.24 0 1.62-.02 2.93-.02 3.33 0 .32.21.7.83.58C20.57 21.79 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a href="mailto:kaizheng.work@gmail.com" aria-label="Email" class="transition-colors hover:text-[var(--accent-strong)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
      <a href="https://x.com/zhengkai15" aria-label="Twitter" class="transition-colors hover:text-[var(--accent-strong)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <a href="/rss.xml" aria-label="RSS" class="transition-colors hover:text-[var(--accent-strong)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="mx-auto max-w-3xl pt-4 pb-16">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Recent Posts</h2>
      <a href="/post/" class="text-sm transition-colors hover:text-[var(--accent-strong)]" style="color: var(--text-muted);">
        查看全部 →
      </a>
    </div>

    <div class="flex flex-col divide-y" style="border-color: var(--border);">
      {
        recentPosts.map((post) => (
          <a href={`/post/${post.id}/`} class="group flex items-baseline justify-between gap-4 py-3.5">
            <span class="font-medium transition-colors group-hover:text-[var(--accent-strong)]">
              {post.data.title}
            </span>
            <time class="shrink-0 text-sm tabular-nums" style="color: var(--text-muted);">
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short' })}
            </time>
          </a>
        ))
      }

      {
        recentPosts.length === 0 && (
          <p class="py-8 text-center" style="color: var(--text-muted);">暂无已发布文章</p>
        )
      }
    </div>
  </section>
</BaseLayout>
