---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  posts: CollectionEntry<'post'>[];
  currentPage?: number;
  totalPages?: number;
}

const { title, description, posts, currentPage = 1, totalPages = 1 } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl">
    <header class="mb-8">
      <h1 class="text-2xl font-semibold">{title}</h1>
      {
        description && (
          <p class="mt-2" style="color: var(--text-muted);">{description}</p>
        )
      }
    </header>

    <div class="flex flex-col gap-6">
      {
        posts.map((post) => (
          <article class="rounded-xl border p-6 transition-shadow" style="border-color: var(--border); background: var(--surface);">
            <div class="mb-2 flex items-center gap-3 text-xs" style="color: var(--text-muted);">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <a
                href={`/categories/${post.data.categories}/`}
                class="rounded-full px-2 py-0.5 transition-colors"
                style="background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent-strong);"
              >
                {post.data.categories}
              </a>
            </div>

            <h2 class="text-lg font-semibold leading-snug">
              <a href={`/post/${post.id}/`} class="transition-colors hover:text-[var(--accent-strong)]">
                {post.data.title}
              </a>
            </h2>

            <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-muted);">
              {post.data.description}
            </p>

            <div class="mt-3 flex flex-wrap gap-2">
              {
                post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}/`}
                    class="text-xs transition-colors hover:text-[var(--accent-strong)]"
                    style="color: var(--text-muted);"
                  >
                    #{tag}
                  </a>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <nav class="mt-10 flex items-center justify-center gap-2 text-sm">
          {
            currentPage > 1 && (
              <a
                href={currentPage === 2 ? '/post/' : `/post/page/${currentPage - 1}/`}
                class="rounded-md border px-3 py-1.5"
                style="border-color: var(--border);"
              >
                ← 上一页
              </a>
            )
          }
          <span style="color: var(--text-muted);">{currentPage} / {totalPages}</span>
          {
            currentPage < totalPages && (
              <a
                href={`/post/page/${currentPage + 1}/`}
                class="rounded-md border px-3 py-1.5"
                style="border-color: var(--border);"
              >
                下一页 →
              </a>
            )
          }
        </nav>
      )
    }
  </div>
</BaseLayout>
